---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "A personal blog on backend, systems, and first principles." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Runs before paint: no flash of wrong theme -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        const theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand">divyansh<span>.dev</span></a>
        <nav class="nav">
          <a href="/">Blog</a>
          <a href="/tags">Tags</a>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>&copy; {new Date().getFullYear()} Divyansh. Built with Astro.</p>
      </div>
    </footer>

    <style>
      .site-header {
        border-bottom: 1px solid var(--border);
        position: sticky;
        top: 0;
        background: color-mix(in srgb, var(--bg) 85%, transparent);
        backdrop-filter: blur(10px);
        z-index: 50;
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.9rem 1.25rem;
      }
      .brand { font-weight: 700; font-size: 1.05rem; }
      .brand span { color: var(--accent); }
      .nav { display: flex; align-items: center; gap: 1.25rem; font-size: 0.92rem; }
      .site-footer {
        border-top: 1px solid var(--border);
        margin-top: 4rem;
        padding: 2rem 0;
        color: var(--text-dim);
        font-size: 0.85rem;
      }
      main { padding: 2.5rem 1.25rem 4rem; min-height: 60vh; }
    </style>
  </body>
</html>